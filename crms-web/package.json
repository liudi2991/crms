{
  "name": "crms-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest --run",
    "gen:api": "openapi --input ../docs/openapi.yml --output src/api/generated --client axios --useOptions --indent 2"
  },
  "dependencies": {
    "vue": "^3.4.27",
    "vue-router": "^4.3.2",
    "pinia": "^2.1.7",
    "element-plus": "^2.7.3",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.2",
    "echarts": "^5.5.0",
    "dayjs": "^1.11.11",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "vite": "^5.2.13",
    "vue-tsc": "^2.0.19",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12",
    "@types/lodash-es": "^4.17.12",
    "@types/nprogress": "^0.2.3",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.27.0",
    "openapi-typescript-codegen": "^0.29.0",
    "sass": "^1.77.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "prettier": "^3.3.0",
    "vitest": "^1.6.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.0"
  }
}
