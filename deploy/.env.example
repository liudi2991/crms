# 复制为 .env 后填入真实值，不要提交到 git。
# 仅放"密钥/密码/可调参数"，不放 host。

REGISTRY=registry.internal/crms
IMAGE_TAG=1.0.0

# MySQL
MYSQL_DATABASE=crms
MYSQL_USERNAME=crms
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root

# Redis（无密码留空即可）
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio
MINIO_BUCKET=crms

# AES-256-GCM 主密钥（必须 32 字符）
# 生成：openssl rand -base64 24 | head -c 32
CRMS_AES_KEY=please-generate-and-replace-this!

# 告警邮件
ALERT_EMAIL=crms-dev@company.com
